{
  "name": "trading-agent",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test packages/ledger/test/*.test.js packages/trading/test/*.test.js apps/trading-agent/test/*.test.js",
    "check": "node scripts/check.mjs",
    "pack": "node scripts/pack.mjs",
    "install:harness": "node scripts/install.mjs",
    "start": "node apps/trading-agent/cli.js serve",
    "agent": "node apps/trading-agent/cli.js run",
    "doctor": "node apps/trading-agent/cli.js doctor",
    "native": "node apps/trading-agent/cli.js native",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0"
  },
  "description": "Options research, strategy ledger, and human-confirmed IBKR paper trading.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leon1689/trading-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Leon1689/trading-agent/issues"
  },
  "homepage": "https://github.com/Leon1689/trading-agent#readme",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "keywords": [
    "trading-agent",
    "options",
    "greeks",
    "ibkr",
    "paper-trading"
  ]
